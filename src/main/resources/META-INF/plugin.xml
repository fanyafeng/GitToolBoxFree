<idea-plugin>
    <id>com.pom.gittoolbox.free</id>
    <name>GitToolBoxFree</name>
    <vendor email="fanyafeng@users.noreply.github.com" url="https://github.com/fanyafeng/GitToolBoxFree">fanyafeng</vendor>

    <description><![CDATA[
    <h2>GitToolBoxFree - 轻量高效、双语支持的 Git 增强插件</h2>
    <p>为 Android Studio 和 IntelliJ 平台带来轻量快速的 Git 体验（支持简体中文与英文）：</p>
    <ul>
        <li><b>行内代码责任人 (Inline Blame)</b>：光标所在行末即时浅灰显示提交人、相对时间（“3天前”、“昨天” / "3 days ago"）及提交信息。高性能防抖渲染，编码丝滑不卡顿。</li>
        <li><b>状态栏仓库指示器 (Status Bar)</b>：右下角实时展示当前分支、领先/落后提交数（↑超前 | ↓落后），支持悬浮气泡提示与快捷菜单。</li>
        <li><b>后台自动拉取 (Auto Fetch)</b>：静默定时执行 git fetch，保持远程提交计数实时准确。</li>
        <li><b>双语设置面板 (Multi-Language Settings)</b>：在“设置 -> 版本控制 -> GitToolBoxFree”中自由切换中英文界面、定制显示模板与防抖时间。</li>
    </ul>
    ]]></description>

    <change-notes><![CDATA[
    <h3>1.0.0</h3>
    <ul>
        <li>支持行内代码责任人 (Inline Blame) 高性能防抖显示与模板配置。</li>
        <li>支持底部状态栏分支与超前/落后提交数 (Ahead / Behind) 指示。</li>
        <li>内置后台静默 Auto Fetch 服务。</li>
        <li>提供简体中文 / English 语言自由切换。</li>
    </ul>
    ]]></change-notes>

    <!-- 兼容平台模块 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 持久化配置服务 -->
        <applicationService serviceImplementation="com.pom.gittoolbox.settings.GitToolBoxSettings"/>

        <!-- 针对项目的 Blame 查询与缓存服务 -->
        <projectService serviceImplementation="com.pom.gittoolbox.blame.GitBlameService"/>

        <!-- 设置面板 (挂载到 Version Control 节点下) -->
        <projectConfigurable
                parentId="project.propVCSSummary"
                instance="com.pom.gittoolbox.settings.GitToolBoxConfigurable"
                id="com.pom.gittoolbox.settings.GitToolBoxConfigurable"
                displayName="GitToolBoxFree"/>

        <!-- 状态栏指示器工厂 -->
        <statusBarWidgetFactory implementation="com.pom.gittoolbox.statusbar.GitStatusBarWidgetFactory"/>

        <!-- 编辑器监听器 (行内 Blame) -->
        <editorFactoryListener implementation="com.pom.gittoolbox.blame.InlineBlameListener"/>

        <!-- 项目启动后台活动 (Auto Fetch) -->
        <postStartupActivity implementation="com.pom.gittoolbox.fetch.AutoFetchService"/>
    </extensions>
</idea-plugin>
